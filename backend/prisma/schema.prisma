generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Usuarios{
  id              Int      @id @default(autoincrement())
  nome            String
  email           String   @unique
  senha_hash      String
  telefone        String   @unique
  nascimento      Date
  grupo_id        Int 
  dataCriacao     DateTime @default(now())
  dataAtualizacao DateTime @updatedAt

  @@map("usuarios")
}

model Grupos{
  id          Int    @id @default(autoincrement())
  nome        String
  descricao   String

  @@map("grupos")
}